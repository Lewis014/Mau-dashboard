# Dashboard MAU — Variables de entorno
# Copia este archivo a .env y completa los valores

# PostgreSQL (mismos valores que el .env del stack contatech-aegis)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=n8n
DB_USER=           # = POSTGRES_USER del stack n8n
DB_PASSWORD=       # = POSTGRES_PASSWORD del stack n8n

# Anthropic — extracción estructurada del backfill (Claude tool-use)
ANTHROPIC_API_KEY=

# OpenAI — embeddings para el scoring de conversión (text-embedding-3-large)
OPENAI_API_KEY=

# Token de acceso al dashboard (genera uno con: openssl rand -hex 32)
APP_TOKEN=

# Login del dashboard. Si la contraseña lleva $, encierra el valor en comillas
# simples para que docker compose no lo interprete: ADMIN_PASS='Pass$$2026'
ADMIN_USER=admin
ADMIN_PASS=
SECRET_KEY=              # opcional; si falta se usa APP_TOKEN o ADMIN_PASS
SESSION_TTL_SECONDS=43200

# Un usuario por vendedor: 'usuario:clave' separados por coma. Es lo que hace que el autor
# de cada nota sea un hecho y no una declaracion — el token de sesion lleva dentro quien
# entro. Los nombres deben coincidir con las etiquetas de Responsable (alyssa/diego/jhon).
# La coma separa entradas, asi que las claves no pueden llevar comas.
DASHBOARD_USERS=         # alyssa:clave1,diego:clave2,jhon:clave3

# Extractor del backfill (Claude tool-use)
EXTRACT_MODEL=claude-sonnet-4-6

# Scoring de conversión: encoder y ruta al modelo portable (leads_model.json)
EMBED_MODEL=text-embedding-3-large
MODEL_PATH=/models/leads_model.json

# mau-web — estado comercial de los leads (app/sync_planes.py).
# El token es el API_TOKEN del .env de mau-web; viaja en la cabecera Authorization tal cual,
# sin prefijo "Bearer" (asi lo compara el middleware auth_api_token).
MAUWEB_API_URL=https://bot.contatech.lat
MAUWEB_API_TOKEN=
# Hora local (LOCAL_TZ) del sync diario. -1 lo desactiva y deja solo el boton del dashboard.
# Las alertas se evaluan justo despues del sync, en el mismo ciclo y a la misma hora.
SYNC_PLANES_HORA=7

# Alertas automaticas (app/alertas.py). Sin ALERTAS_WEBHOOK_URL no se envia nada: las
# reglas se siguen pudiendo mirar desde el dashboard, pero nadie recibe el aviso.
# El webhook es un flujo de n8n, que ya vive en este stack y ya habla con WhatsApp; aqui
# solo se manda el JSON con el mensaje ya formateado en la clave "texto".
ALERTAS_WEBHOOK_URL=
ALERTAS_WEBHOOK_TOKEN=   # viaja en la cabecera Authorization tal cual, sin prefijo
# Con cuanta antelacion se avisa. Estos numeros salen tambien en el propio mensaje y en la
# pantalla del dashboard, para que quien lo recibe sepa por que le llega hoy.
ALERTAS_TRIAL_DIAS=3     # prueba gratis que vence en N dias o menos
ALERTAS_PAGO_DIAS=2      # pago que lleva N dias o mas en verificacion sin aprobarse
# Responsable de los leads que no tienen etiqueta de responsable. VACIO A PROPOSITO: si no
# hay nadie asignado, la alerta NO se construye. Un aviso sin dueño no lo atiende nadie.
ALERTAS_DUENO_DEFECTO=
# URL publica del dashboard, para que cada alerta lleve el enlace al lead. Opcional.
DASHBOARD_URL=

# Chatwoot — fuente de verdad de los transcripts (backfill --source chatwoot)
CHATWOOT_HOST=http://chatwoot_web:3000
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1
CHATWOOT_API_TOKEN=        # Perfil > Configuración > Access Token (admin) en Chatwoot
